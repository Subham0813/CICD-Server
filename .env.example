PORT=4566
WEBHOOK_SECRET=your_github_webhook_secret_here

# Redis Configuration (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Deployment Script & Target Application
DEPLOY_SCRIPT_PATH=./deploy.sh
TARGET_DIR=../learning-gh-action
TARGET_PORT=4000

# GitHub Status API (PAT with repo:status or commit status permissions)
GITHUB_TOKEN=

# Slack / Discord Incoming Webhook URL (Optional)
# For Discord: add /slack at the end of the Discord webhook URL
SLACK_WEBHOOK_URL=
