PORT=4566
WEBHOOK_SECRET=your_github_webhook_secret_here

# Redis Configuration (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

#health check vars
MAX_RETRIES=   ##default is 10
RETRY_DELAY=   ##default is 2

# Engine Paths
DEPLOY_SCRIPT_PATH=./scripts/deploy.sh
PROJECTS_CONFIG_PATH=./projects.config.json

# GitHub Status API (PAT with repo:status or commit status permissions)
GITHUB_TOKEN=

# Slack Incoming Webhook URL (Optional)
SLACK_WEBHOOK_URL=
